content-type: {{ContentType}}

###

POST http://{{hostname}}:{{port}} HTTP/1.1
content-type: {{ContentType}}

{
    "name": "configure"
}

###

GET http://{{hostname}}:{{port}} HTTP/1.1
content-type: {{ContentType}}

###

GET http://{{hostname}}:{{port}}/history HTTP/1.1
content-type: {{ContentType}}

###

POST http://{{hostname}}:{{port}} HTTP/1.1
content-type: {{ContentType}}

{
    "command": "create"
}

###

GET http://{{hostname}}:{{port}} HTTP/1.1
content-type: {{ContentType}}

###

GET http://{{hostname}}:{{port}}/history HTTP/1.1
content-type: {{ContentType}}

###

POST http://{{hostname}}:{{port}} HTTP/1.1
content-type: {{ContentType}}
Idempotency-Key: 7d1e4a36-0b8a-4c51-9c0e-2b8f1e6f2a10

{
    "name": "create"
}

### Descriptor of the digital twin

GET http://{{hostname}}:{{port}}/dt HTTP/1.1
content-type: {{ContentType}}

### State of the digital twin

GET http://{{hostname}}:{{port}}/state HTTP/1.1
content-type: {{ContentType}}

### Health of the runner

GET http://{{hostname}}:{{port}}/health HTTP/1.1
content-type: {{ContentType}}

### State machine of test/data/scripts/state-machine.yaml

GET http://{{hostname}}:{{port}}/fsm HTTP/1.1
content-type: {{ContentType}}

###

POST http://{{hostname}}:{{port}}/fsm/transition HTTP/1.1
content-type: {{ContentType}}

{
    "state": "create"
}

###

POST http://{{hostname}}:{{port}}/fsm/event HTTP/1.1
content-type: {{ContentType}}

{
    "event": "restart"
}

###

POST http://{{hostname}}:{{port}}/fsm/event HTTP/1.1
content-type: {{ContentType}}

{
    "event": "stop"
}

### Parameters of test/data/scripts/state-machine.yaml

GET http://{{hostname}}:{{port}}/parameters HTTP/1.1
content-type: {{ContentType}}

###

PUT http://{{hostname}}:{{port}}/parameters HTTP/1.1
content-type: {{ContentType}}

{
    "scope": "multi"
}

### Stop every running command

POST http://{{hostname}}:{{port}}/stop HTTP/1.1

###

POST http://{{hostname}}:{{port}}/stop HTTP/1.1
content-type: {{ContentType}}

{
    "name": "execute"
}
