id: 'test-dt'
port: 5000
location: '../test/data/scripts'  # test scripts, relative to this config file
commands:  # list of permitted scripts
  - create
  - execute
  - echo-input
  - fail
stateMachine: '../test/data/scripts/state-machine.yaml'
