# A sample state machine of a digital twin, the hospital-1 twin of
# demo/hospital. Name it in runner.yaml with
#   stateMachine: 'state-machine.yaml'
# Every state runs the script of the same name, so runner.yaml must
# permit open, full and closed, and the Manager's commands admit and
# discharge, under commands; the subscriptions need a peer hospital-2
# under relationships.peers. STATE-MACHINE.md describes every key.
events:  # the events a client, a script or a subscription may raise
  - full
  - beds-free
  - scope-changed
  - fidelity-changed
  - close
  - reopen
  - neighbour-full
  - neighbour-down
parameters:  # optional; values that scripts read as DT_PARAM_<NAME>
  scope:  # where a patient may go: the requested ward, or any free one
    type: string  # string, number, integer or boolean
    enum:  # optional; the values that the parameter may take
      - single
      - multi
    default: single
    controllable: true  # a Manager may set it with PUT /parameters
    event: scope-changed  # optional; raised when the value changes
  capacity:  # beds per ward; a Manager may read but not change it
    type: integer
    minimum: 1  # optional, as maximum; for numbers and integers
    default: 2
    controllable: false
  fidelity:  # how often open samples the beds (STATE-MACHINE.md)
    type: string
    enum:
      - low
      - medium
      - high
    default: medium
    controllable: true
    event: fidelity-changed
properties:  # optional; the latest values that scripts and sensors write
  free-beds:  # null until its first write with PUT /properties
    type: integer  # also string, number, boolean, object or array
    minimum: 0
    unit: beds  # every number names its unit; '1' for a number without one
  ward-status:
    type: string
    enum:
      - open
      - full
      - closed
  forecast:  # free beds in each of the next hours
    type: array
    items:
      type: number
      unit: beds
env:  # optional; variables for every script, with ${...} of the runner
  HINT: '${DT_ID}/${DT_STATE}#${DT_ENTRY} scope=${DT_PARAM_SCOPE}'
escalation:  # optional; when the runner escalates to the Manager itself
  onFailure: true  # a $failure with no transition
  onNoTransition: true  # an event with no transition from the state
manager:  # optional; the commands that the role manager may run
  commands:
    - admit
    - discharge
subscriptions:  # optional; events raised when a condition on a peer turns true
  - peer: hospital-2
    when:
      state: full
    event: neighbour-full
  - peer: hospital-2
    when:
      online: false
    event: neighbour-down
states:  # optional; each state runs the script of its name
  open:
    env:  # optional; variables for this state's script only
      POLL_MS: 500
    transitions:  # event: state, or event: {state, stop: true}
      full: full  # a plain transition leaves the old script running
      scope-changed:  # stop: true stops the script, then enters the state
        state: open
        stop: true
      fidelity-changed:
        state: open
        stop: true
      neighbour-full:
        state: open
        stop: true
      neighbour-down:
        state: open
        stop: true
      close:
        state: closed
        stop: true
      $stopped: closed  # $success, $failure and $stopped end a script
  full:
    transitions:
      beds-free: open
  closed:
    transitions:
      reopen: open
