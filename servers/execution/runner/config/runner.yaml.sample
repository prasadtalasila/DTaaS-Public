id: 'my-dt'  # names the digital twin; letters, digits, _, . or -, up to 64
# attributes:  # optional; facts about the digital twin for a Manager
#   city: 'Aarhus'  # values are strings, numbers or booleans
#   beds: 120
port: 5000
location: 'scripts'  # directory of scripts, relative to this config file
commands:  # list of permitted scripts
  - create
  - execute
  - terminate
# stateMachine: 'scripts/state-machine.yaml'  # optional, relative to this file
# database: 'runner.db'  # optional; keeps the command history in a file
# stopGrace: 5000  # optional; milliseconds from SIGTERM to SIGKILL on a stop
# mqtt:  # optional; serves the API over MQTT as well
#   url: 'mqtt://localhost:1883'
#   topic: 'dtaas/user1/runner'  # base topic, unique to this runner
#   username: 'runner'
#   password: 'secret'
#   protocolVersion: 5  # 4 for brokers that support only MQTT 3.1.1
