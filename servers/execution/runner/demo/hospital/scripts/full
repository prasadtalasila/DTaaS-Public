#!/usr/bin/env bash
# State full: no free bed is left. The patients can go to a peer that is
# open, which GET /peers tells; without one, the script fails, and as
# the state has no $failure transition, the runner escalates to the
# Manager.
. "$(dirname "$0")/ward.sh"
overflow=$(get_overflow)
if [[ $overflow != none ]]; then
  write_ward_log "full   entry $DT_ENTRY: no free bed, overflow to $overflow"
  exit 0
fi
write_ward_log "full   entry $DT_ENTRY: no free bed and no open peer"
echo 'no local adaptation left and no open peer' >&2
exit 2
