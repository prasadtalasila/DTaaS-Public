[18.617,"o","# The state machine of the digital twin of hospital-1. The hospital is\r\n# open for admissions, full, or closed; each state runs the script of\r\n# the same name in scripts/.\r\nevents:\r\n  - full\r\n  - beds-free\r\n  - scope-changed\r\n  - fidelity-changed\r\n  - close\r\n  - reopen\r\n  - neighbour-full\r\n  - neighbour-down\r\nparameters:\r\n  # the shared-policy parameter: a patient goes to the requested ward\r\n  # only (single), or to any ward with a free bed (multi)\r\n  scope:\r\n    type: enum\r\n    values:\r\n      - single\r\n      - multi\r\n    default: single\r\n    controllable: true\r\n    event: scope-changed\r\n  # beds per ward, which the Manager may read but not change\r\n  capacity:\r\n    type: number\r\n    default: 2\r\n    controllable: false\r\n  # how often open samples the beds, from the cheapest to the most\r\n  # accurate (STATE-MACHINE.md, Pattern: Fidelity)\r\n  fidelity:\r\n    type: enum\r\n    values:\r\n      - low\r\n      - medium\r\n      - high\r\n    default: medium\r\n    controllable: true\r\n    event: fidelity-changed\r\n"]
