[4.267,"o","# The runner of the digital twin of hospital-1, for the bed-management\r\n# demo; see README.md. record.mjs writes runner.auth.yaml from it, with\r\n# the publicKey of hospital-2 and an auth section, so the peer's entry\r\n# stays last.\r\nid: 'hospital-1'\r\nattributes:\r\n  name: 'Hospital 1'\r\n  city: 'Aarhus'\r\n  latitude: 56.19\r\n  longitude: 10.17\r\n  wards: 2\r\nport: 5100\r\nlocation: 'scripts'\r\ncommands:\r\n  - open\r\n  - full\r\n  - closed\r\n  - admit\r\n  - discharge\r\nstateMachine: 'hospital.fsm.yaml'\r\ndatabase: 'run/hospital-1/hospital.db'\r\n# milliseconds from SIGTERM to SIGKILL on a stop\r\nstopGrace: 1000\r\nmqtt:\r\n  url: 'mqtt://127.0.0.1:18830'\r\n  topic: 'dtaas/hospital-1'\r\n  # the local aedes broker speaks MQTT 3.1.1 only\r\n  protocolVersion: 4\r\nnotify:\r\n  url: 'http://127.0.0.1:18080/dt-events'\r\n# the peers that this digital twin is willing to interact with\r\npeers:\r\n  - id: 'hospital-2'\r\n    topic: 'dtaas/hospital-2'\r\n    url: 'http://localhost:5200'\r\n    attributes:\r\n      distance: 12.4\r\n"]
