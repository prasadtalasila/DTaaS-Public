[16.428,"o","# The class of the hospital twins: both hospital-1 and hospital-2 run\r\n# this file, each with the values and the peers of its own runner.yaml.\r\n# A hospital is open for admissions, full, or closed; each state runs\r\n# the script of the same name in scripts/.\r\nclass:\r\n  id: 'urn:dtaas:demo:hospital'\r\n  version: '1.0.0'\r\nevents:\r\n  - full\r\n  - beds-free\r\n  - scope-changed\r\n  - fidelity-changed\r\n  - close\r\n  - reopen\r\n  - neighbour-full\r\n  - neighbour-down\r\nparameters:\r\n  # the shared-policy parameter: a patient goes to the requested ward\r\n  # only (single), or to any ward with a free bed (multi)\r\n  scope:\r\n    type: string\r\n    enum:\r\n      - single\r\n      - multi\r\n    default: single\r\n    controllable: true\r\n    event: scope-changed\r\n  # beds per ward, which the Manager may read but not change; an\r\n  # instance sets its own under parameters in runner.yaml\r\n  capacity:\r\n    type: integer\r\n    minimum: 1\r\n    default: 2\r\n    controllable: false\r\n  # how often open samples the beds, from the cheapest to the most\r\n  # accurate (STATE-MACHINE.md, Pattern: Fidelity)\r\n  fidelity:\r\n    type: string\r\n    enum:\r\n      - low\r\n      - medium\r\n      - high\r\n    default: medium\r\n    controllable: true\r\n    event: fidelity-changed\r\n"]
