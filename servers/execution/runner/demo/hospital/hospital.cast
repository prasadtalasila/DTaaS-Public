[7.274,"o","# The state machine of the hospital digital twin. The hospital is open\r\n# for admissions, full, or closed; each state runs the script of the same\r\n# name in scripts/.\r\nevents:\r\n  - full\r\n  - beds-free\r\n  - scope-changed\r\n  - close\r\n  - reopen\r\nparameters:\r\n  # the shared-policy parameter: a patient goes to the requested ward\r\n  # only (single), or to any ward with a free bed (multi)\r\n  scope:\r\n    type: enum\r\n    values:\r\n      - single\r\n      - multi\r\n    default: single\r\n    controllable: true\r\n    event: scope-changed\r\n  # beds per ward, which the Manager may read but not change\r\n  capacity:\r\n    type: number\r\n    default: 2\r\n    controllable: false\r\nenv:\r\n  HINT: '${DT_ID}/${DT_STATE}#${DT_ENTRY} scope=${DT_PARAM_SCOPE}'\r\nescalation:\r\n  onFailure: true\r\n  onNoTransition: true\r\nmanager:\r\n  commands:\r\n    - admit\r\n    - discharge\r\n"]
