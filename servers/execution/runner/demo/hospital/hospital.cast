[4.141,"o","# The runner of the digital twin of one hospital, for the bed-management\r\n# demo; see README.md\r\nid: 'hospital-1'\r\nattributes:\r\n  name: 'Hospital 1'\r\n  city: 'Aarhus'\r\n  latitude: 56.19\r\n  longitude: 10.17\r\n  wards: 2\r\nport: 5100\r\nlocation: 'scripts'\r\ncommands:\r\n  - open\r\n  - full\r\n  - closed\r\n  - admit\r\n  - discharge\r\nstateMachine: 'hospital.fsm.yaml'\r\ndatabase: 'run/hospital.db'\r\n# milliseconds from SIGTERM to SIGKILL on a stop\r\nstopGrace: 1000\r\nmqtt:\r\n  url: 'mqtt://127.0.0.1:18830'\r\n  topic: 'dtaas/hospital-1'\r\n  # the local aedes broker speaks MQTT 3.1.1 only\r\n  protocolVersion: 4\r\nnotify:\r\n  url: 'http://127.0.0.1:18080/dt-events'\r\n"]
