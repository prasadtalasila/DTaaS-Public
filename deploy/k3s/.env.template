# DTaaS Environment Configuration Template
# Copy this file to .env and update with your actual values

# Server Configuration
SERVER_DNS=foo.com

# OAuth Configuration (GitLab)
OAUTH_URL=https://gitlab.foo.com
OAUTH_CLIENT_ID=your-client-id-here
OAUTH_CLIENT_SECRET=your-client-secret-here
OAUTH_SECRET=your-random-secret-string-here

# User Configuration
USERNAME1=user1
USERNAME2=user2

# Storage Configuration
DTAAS_FILES_PATH=/dtaas/files

# TLS Certificate Paths (for creating secret)
TLS_CERT_PATH=/path/to/fullchain.pem
TLS_KEY_PATH=/path/to/privkey.pem
