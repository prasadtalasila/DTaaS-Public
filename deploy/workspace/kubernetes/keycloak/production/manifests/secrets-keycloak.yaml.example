# Keycloak Admin Credentials Secret
# Replace placeholder values with actual credentials before applying.
# Generate with:
#   kubectl create secret generic dtaas-keycloak \
#     --from-literal=KEYCLOAK_ADMIN=admin \
#     --from-literal=KEYCLOAK_ADMIN_PASSWORD=<ADMIN_PASSWORD> \
#     --namespace=dtaas-workspace \
#     --dry-run=client -o yaml > secrets-keycloak.yaml
apiVersion: v1
kind: Secret
metadata:
  name: dtaas-keycloak
  namespace: dtaas-workspace
type: Opaque
stringData:
  KEYCLOAK_ADMIN: admin
  KEYCLOAK_ADMIN_PASSWORD: REPLACE_WITH_STRONG_ADMIN_PASSWORD
