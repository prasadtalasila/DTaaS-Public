# Forward Auth (OIDC) Secrets
# Replace placeholder values with actual credentials before applying.
# Generate with:
#   kubectl create secret generic dtaas-forward-auth \
#     --from-literal=PROVIDERS_OIDC_ISSUER_URL=https://intocps.org/auth/realms/dtaas \
#     --from-literal=PROVIDERS_OIDC_CLIENT_ID=dtaas-workspace \
#     --from-literal=PROVIDERS_OIDC_CLIENT_SECRET=your_keycloak_client_secret_here \
#     --from-literal=SECRET=your_random_secret_key_here \
#     --namespace=dtaas-workspace \
#     --dry-run=client -o yaml > secrets-forward-auth.yaml
apiVersion: v1
kind: Secret
metadata:
  name: dtaas-forward-auth
  namespace: dtaas-workspace
type: Opaque
stringData:
  PROVIDERS_OIDC_ISSUER_URL: https://intocps.org/auth/realms/dtaas
  PROVIDERS_OIDC_CLIENT_ID: dtaas-workspace
  PROVIDERS_OIDC_CLIENT_SECRET: REPLACE_WITH_KEYCLOAK_CLIENT_SECRET
  SECRET: REPLACE_WITH_RANDOM_OAUTH_SECRET
