# TLS Secret - replace placeholder values with base64-encoded certificate data
# Generate with:
#   kubectl create secret tls dtaas-tls \
#     --cert=./certs/fullchain.pem \
#     --key=./certs/privkey.pem \
#     --namespace=dtaas-workspace \
#     --dry-run=client -o yaml > secrets-tls.yaml
apiVersion: v1
kind: Secret
metadata:
  name: dtaas-tls
  namespace: dtaas-workspace
type: kubernetes.io/tls
data:
  tls.crt: REPLACE_WITH_BASE64_ENCODED_FULLCHAIN_PEM
  tls.key: REPLACE_WITH_BASE64_ENCODED_PRIVKEY_PEM
